# Gost-Net Environment & Operational Configuration
# Copy this file to .env or set environment variables in your deployment environment.

# ==============================================================================
# Runtime & Testing Modes
# ==============================================================================
# Set to 1 to enable non-blocking test mode (fast background worker injection)
TESTING=0

# Set to 1 to enable verbose cryptographic and network logging to stdout
DEBUG=0

# Force headless mock platform drivers (useful on Linux/Docker servers without Bluetooth/WiFi Direct hardware)
GHOSTNET_MOCK_PLATFORM=0

# ==============================================================================
# Mesh Networking Defaults
# ==============================================================================
# UDP broadcast port for peer beacon discovery
GHOSTNET_UDP_PORT=37020

# Base TCP listening port for P2P direct sessions (0 for dynamic OS port selection)
GHOSTNET_TCP_PORT=0

# Max DTN message spool retention window (in hours) before automatic secure shredding
GHOSTNET_RETENTION_HOURS=24

# ==============================================================================
# Storage & Hardware
# ==============================================================================
# Optional custom storage directory for database and key store
# Default is current directory on desktop or app storage on Android
# GHOSTNET_DATA_DIR=.
