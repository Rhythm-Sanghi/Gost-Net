secret.key
secret.key.enc
signing.key.enc
.db_salt
.decoy_mode
.failed_attempts
.dead_man_switch
spool/
notes.txt
*.part
*.pem
*.p12
*.pfx
*.crt
*.cer
ghostnet.db
ghostnet_persistence.db
.auth_secrets
test_*.db*
test_*.key

# ─── User Data & Runtime State ───────────────────────────────────────────────
downloads/
recordings/
*.log
*.telemetry
settings.json
ghostnet_settings.json

# ─── IDEs & Editors ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

