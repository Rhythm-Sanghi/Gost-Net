# =============================================================================
# Ghost Net — .gitignore
# Python / Kivy / Android / Buildozer project
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ─── Distribution / Packaging ────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
*.whl

# ─── Testing & Coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.lcov
nosetests.xml
test-results/
test_settings.json

# ─── Kivy Runtime Artifacts ──────────────────────────────────────────────────
*.pyc
kivy-garden/
.kivy/
*.kv~

# ─── Buildozer / Android Build ───────────────────────────────────────────────
.buildozer/
bin/
*.apk
*.aab
*.ipa
*.so
*.jks
*.keystore

